@model IEnumerable<ServiciosEC.Models.Auditoria>

@{
    ViewData["Title"] = "Actividad / Auditoría";
}

<!-- Encabezado -->
<div class="app-card app-mb-4">
    <div class="app-card__body text-center">
        <h5 class="mb-0">
            <span class="app-text-muted">Registro de actividad del sistema</span>
        </h5>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="app-card">
        <div class="app-card__header">
            <h5 class="app-card__title">
                <i class="fas fa-history me-2"></i> Historial de cambios
            </h5>
        </div>
        <div class="app-card__body p-0">
            <div class="table-responsive">
                <table id="tablaAuditoria" class="app-table app-table--striped">
                    <thead>
                        <tr>
                            <th>Tabla</th>
                            <th>Acción</th>
                            <th>Fecha</th>
                            <th>Usuario</th>
                            <th>Datos anteriores</th>
                            <th>Datos nuevos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Tabla</td>
                                <td>
                                    @{
                                        var accionLower = (item.Accion ?? "").ToLower();
                                        var badgeClass = accionLower.Contains("insert") || accionLower.Contains("crear") || accionLower.Contains("alta")
                                        ? "app-badge--success"
                                        : accionLower.Contains("update") || accionLower.Contains("editar") || accionLower.Contains("modific")
                                        ? "app-badge--warning"
                                        : accionLower.Contains("delete") || accionLower.Contains("eliminar") || accionLower.Contains("baja")
                                        ? "app-badge--danger"
                                        : "app-badge--neutral";
                                    }
                                    <span class="app-badge @badgeClass">@item.Accion</span>
                                </td>
                                <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@item.Persona?.Nombre @item.Persona?.Apellido</td>
                                <td>
                                    <button type="button"
                                            class="app-btn app-btn--outline app-btn--sm"
                                            data-toggle="modal"
                                            data-target="#modalDatosAntes_@item.Id"
                                            title="Ver datos anteriores">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                                <td>
                                    <button type="button"
                                            class="app-btn app-btn--outline app-btn--sm"
                                            data-toggle="modal"
                                            data-target="#modalDatosDespues_@item.Id"
                                            title="Ver datos nuevos">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modales para ver JSON de cada registro -->
    @foreach (var item in Model)
    {
        <div class="modal fade" id="modalDatosAntes_@item.Id" tabindex="-1"
             aria-labelledby="modalLabelAntes_@item.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content app-modal">
                    <div class="app-modal__header app-modal__header--info">
                        <h5 class="app-modal__title" id="modalLabelAntes_@item.Id">
                            <i class="fas fa-history me-2"></i>
                            Datos anteriores — @item.Tabla / @item.Accion
                        </h5>
                    </div>
                    <div class="app-modal__body">
                        <pre class="app-json">@(string.IsNullOrWhiteSpace(item.DatosAntes) ? "Sin datos" : item.DatosAntes)</pre>
                    </div>
                    <div class="app-modal__footer">
                        <button type="button" class="app-btn app-btn--outline" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modalDatosDespues_@item.Id" tabindex="-1"
             aria-labelledby="modalLabelDespues_@item.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content app-modal">
                    <div class="app-modal__header app-modal__header--success">
                        <h5 class="app-modal__title" id="modalLabelDespues_@item.Id">
                            <i class="fas fa-check-circle me-2"></i>
                            Datos nuevos — @item.Tabla / @item.Accion
                        </h5>
                    </div>
                    <div class="app-modal__body">
                        <pre class="app-json">@(string.IsNullOrWhiteSpace(item.DatosDespues) ? "Sin datos" : item.DatosDespues)</pre>
                    </div>
                    <div class="app-modal__footer">
                        <button type="button" class="app-btn app-btn--outline" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="app-empty">
        <i class="fas fa-history"></i>
        <h4>No hay actividad registrada</h4>
        <p>No se encontraron registros de auditoría en el sistema.</p>
    </div>
}

@section Scripts {
    <script>
        $(function () {
            if ($.fn.DataTable) {
                $('#tablaAuditoria').DataTable({
                    paging: true,
                    lengthChange: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    responsive: true,
                    order: [[2, 'desc']],   // Ordenar por fecha descendente
                    language: {
                        url: "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                    },
                    columnDefs: [
                        { targets: [4, 5], orderable: false }   // Los botones no ordenan
                    ]
                });
            }
        });
    </script>
}