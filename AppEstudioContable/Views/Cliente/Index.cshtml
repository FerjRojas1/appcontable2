
@model IEnumerable<ServiciosEC.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
    var filtro = ViewBag.Filtro as string ?? "";
    var successMessage = TempData["SuccessMessage"] as string;
}

<div class="bg-white border border-secondary rounded shadow-sm p-3 mb-3 text-center">
    <h4 class="text-dark fw-bold mb-0">
        <i class="fas fa-user-tie me-2"></i> Gestión de Clientes
    </h4>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title">Clientes Registrados</h3>
                <a asp-action="Create" class="btn btn-success btn-sm btn-shine">
                    <i class="fas fa-plus"></i> Crear nuevo
                </a>
                <a asp-action="VerInactivos" class="btn btn-warning btn-sm btn-shine">
                    <i class="fas fa-plus"></i> Ver Inactivos
                </a>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i> @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            
                <!-- Tabla de clientes -->
                <div class="table-responsive">
                    <table id="tablaClientes" class="table table-bordered table-hover text-nowrap">
                        <thead class="thead-light">
                            <tr>                                
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Cuit</th>
                                <th>Domicilio Fiscal</th>
                                <th>Razon Social</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                             @foreach (var item in Model) 
                             {
                                <tr>
                                    <td>@item.Nombre</td>
                                    <td>@item.Apellido</td>
                                    <td>@item.Cuit</td>
                                    <td>@item.DomFiscal</td>
                                    <td>@item.RazonSocial</td>
                                    <td class="text-center">

                                        <div class="btn-group">
                                            
                                            <a asp-action="Details" asp-route-id="@item.IdPersona" class="btn btn-info btn-sm btn-shine">
                                                <i class="fas fa-info-circle"> Ver Cliente</i>
                                            </a>
                                            
                                        </div>
                                    </td>
                                </tr>
                             }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        crearDataTable('#tablaClientes', 'clientes');
    </script>
}

