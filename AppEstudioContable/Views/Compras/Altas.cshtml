@model AppEstudioContable.Models.CompraViewModel



@{
    ViewData["Title"] = "Gestión de Compras";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
}

<!-- Info del cliente -->
<div class="app-card mb-4">
    <div class="app-card__body text-center">
        <h5 class="mb-0">
            <span class="app-text-muted">Cliente:</span> @ViewBag.RazonSocial
        </h5>
    </div>
</div>


<!-- Panel de importación / carga manual -->
<div class="row">
    <!-- Importar desde Excel -->
    <div class="col-md-6">
        <div class="app-card">
            <div class="app-card__header">
                <h5 class="app-card__title">
                    <i class="fas fa-file-excel me-2"></i> Importar Compras desde Excel
                </h5>
            </div>
            <div class="app-card__body">
                <form id="formCargaExcel"
                      asp-controller="Compras"
                      asp-action="Altas"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="app-form-group">
                        <label for="file" class="app-form-label">
                            Seleccioná un archivo
                            <small class="app-text-muted">(formatos .xlsx, .xls, .csv)</small>
                        </label>

                        <div class="app-file">
                            <input type="file" name="file" id="file"
                                   accept=".xlsx,.xls,.csv"
                                   class="app-file__input" required />
                            <label class="app-file__label" for="file">
                                <i class="fas fa-cloud-upload-alt me-2"></i>
                                <span class="app-file__text">Elegir archivo</span>
                            </label>
                        </div>

                        <div class="app-form-error" id="fileError">
                            @Html.ValidationMessageFor(model => model.ArchivoExcel, "", new { @class = "app-form-error" })
                        </div>
                    </div>

                    <div class="app-form-group">
                        <label class="app-form-label">Excluir tipos de factura (opcional)</label>

                        <div class="app-check">
                            <input class="app-check__input" type="checkbox"
                                   name="tiposFacturaExcluir"
                                   value="Factura B,Nota de Crédito B"
                                   id="excluirComprobantesB" />
                            <label class="app-check__label" for="excluirComprobantesB">
                                Excluir comprobantes tipo B
                            </label>
                        </div>
                    </div>

                    <input type="hidden" name="id" value="@Model.id" />

                    @Html.ValidationSummary(true, "", new { @class = "app-alert app-alert--danger mt-3" })

                    <button type="submit" class="app-btn app-btn--success app-btn--lg app-btn--block app-btn--shine app-mt-4">
                        <i class="fas fa-upload me-2"></i> Cargar Compras
                    </button>

                    <!-- Modal de carga -->
                    <div class="modal fade" id="modalCargando" tabindex="-1"
                         aria-labelledby="modalCargandoLabel" aria-hidden="true"
                         data-backdrop="static" data-keyboard="false">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content app-modal app-modal--loading">
                                <div class="app-modal__body text-center">
                                    <div class="app-spinner">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="sr-only">Cargando...</span>
                                        </div>
                                    </div>
                                    <h5 class="mb-0 app-text-muted">Procesando archivo, por favor esperá...</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Carga manual -->
    <div class="col-md-6">
        <div class="app-card h-100">
            <div class="app-card__header">
                <h5 class="app-card__title">
                    <i class="fas fa-keyboard me-2"></i> Cargar Compra Manual
                </h5>
            </div>
            <div class="app-card__body app-flex-center" style="min-height: 200px;">
                <div class="text-center">
                    <p class="app-text-muted app-mb-4">
                        Ingresá los detalles de una nueva compra manualmente.
                    </p>
                    <form asp-controller="Compras" asp-action="Create" method="get">
                        <input type="hidden" name="id" value="@Model.id" />
                        <button type="submit" class="app-btn app-btn--primary app-btn--lg app-btn--shine">
                            <i class="fas fa-plus-circle me-2"></i> Agregar Nueva Compra
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================== Facturas para revisar ===================== -->
@if (Model.comprasParaRevisar.Any())
{
    <div class="app-card app-card--warning app-mt-5">
        <div class="app-card__header app-card__header--warning">
            <h5 class="app-card__title">
                <i class="fas fa-check-double me-2"></i>
                Facturas para revisar: @Model.comprasParaRevisar.Count()
            </h5>
        </div>
        <div class="app-card__body p-0">
            <div class="table-responsive">
                <table id="comprasAgregadas" class="app-table app-table--striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>P.Venta</th>
                            <th>Nro. Desde</th>
                            <th>Nro. Hasta</th>
                            <th>Tipo Doc. Vend.</th>
                            <th>Nro. Doc. Vend.</th>
                            <th>Denom. Vendedor</th>
                            <th>Tipo Cambio</th>
                            <th>Moneda</th>
                            <th>Neto Gravado</th>
                            <th>No Gravado</th>
                            <th>Exento</th>
                            <th>IVA</th>
                            <th>Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.comprasParaRevisar)
                        {
                            <tr>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@Html.DisplayFor(m => item.TipoFact)</td>
                                <td>@Html.DisplayFor(m => item.PuntoVenta)</td>
                                <td>@Html.DisplayFor(m => item.NroDesde)</td>
                                <td>@Html.DisplayFor(m => item.NroHasta)</td>
                                <td>@Html.DisplayFor(m => item.TipoDocVendedor)</td>
                                <td>@Html.DisplayFor(m => item.NroDocVendedor)</td>
                                <td>@Html.DisplayFor(m => item.DenomVendedor)</td>
                                <td>@(item.TipoCambio?.ToString() ?? "N/A")</td>
                                <td>@Html.DisplayFor(m => item.Moneda)</td>
                                <td>@(item.NetoGravado?.ToString("N2") ?? "")</td>
                                <td>@(item.NoGravado?.ToString("N2") ?? "")</td>
                                <td>@(item.Exento?.ToString("N2") ?? "")</td>
                                <td>@(item.Iva?.ToString("N2") ?? "")</td>
                                <td>@(item.Total?.ToString("N2") ?? "")</td>
                                <td class="text-center">
                                    <button type="button"
                                            class="app-btn app-btn--outline app-btn--sm"
                                            data-toggle="modal"
                                            data-target="#modalEdit_@item.IdCompra"
                                            title="Editar compra">
                                        <i class="fas fa-edit"></i>
                                    </button>

                                    <!-- Modal edición -->
                                    <div class="modal fade" id="modalEdit_@item.IdCompra" tabindex="-1"
                                         aria-labelledby="modalLabelEdit_@item.IdCompra" aria-hidden="true">
                                        <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                            <div class="modal-content app-modal">
                                                <form method="post" action="/Compras/Edit2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="IdCompra" value="@item.IdCompra" />

                                                    <div class="app-modal__header app-modal__header--info">
                                                        <h5 class="app-modal__title" id="modalLabelEdit_@item.IdCompra">
                                                            <i class="fas fa-pencil-alt me-2"></i>
                                                            Editar Compra #@item.IdCompra
                                                        </h5>
                                                    </div>

                                                    <div class="app-modal__body">
                                                        <!-- Sección 1 -->
                                                        <details class="app-details" open>
                                                            <summary class="app-details__summary">Datos principales</summary>
                                                            <div class="app-details__content row gx-3">
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="Fecha_@item.IdCompra">Fecha</label>
                                                                    <input type="date" class="app-form-control"
                                                                           id="Fecha_@item.IdCompra" name="Fecha"
                                                                           value="@item.Fecha.ToString("yyyy-MM-dd")" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="TipoFact_@item.IdCompra">Tipo Factura</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="TipoFact_@item.IdCompra" name="TipoFact"
                                                                           value="@item.TipoFact" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="PuntoVenta_@item.IdCompra">Punto de Venta</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="PuntoVenta_@item.IdCompra" name="PuntoVenta"
                                                                           value="@item.PuntoVenta" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="NroDesde_@item.IdCompra">Número Desde</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="NroDesde_@item.IdCompra" name="NroDesde"
                                                                           value="@item.NroDesde" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="NroHasta_@item.IdCompra">Número Hasta</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="NroHasta_@item.IdCompra" name="NroHasta"
                                                                           value="@item.NroHasta" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="Moneda_@item.IdCompra">Moneda</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="Moneda_@item.IdCompra" name="Moneda"
                                                                           value="@item.Moneda" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="TipoCambio_@item.IdCompra">Tipo de Cambio</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="TipoCambio_@item.IdCompra" name="TipoCambio"
                                                                           value="@item.TipoCambio" required />
                                                                </div>
                                                            </div>
                                                        </details>

                                                        <!-- Sección 2 -->
                                                        <details class="app-details">
                                                            <summary class="app-details__summary">Datos del vendedor</summary>
                                                            <div class="app-details__content row gx-3">
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="DenomVendedor_@item.IdCompra">Denominación Vendedor</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="DenomVendedor_@item.IdCompra" name="DenomVendedor"
                                                                           value="@item.DenomVendedor" />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="TipoDocVendedor_@item.IdCompra">Tipo Documento</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="TipoDocVendedor_@item.IdCompra" name="TipoDocVendedor"
                                                                           value="@item.TipoDocVendedor" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="NroDocVendedor_@item.IdCompra">Número Documento</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="NroDocVendedor_@item.IdCompra" name="NroDocVendedor"
                                                                           value="@item.NroDocVendedor" required />
                                                                </div>
                                                            </div>
                                                        </details>

                                                        <!-- Sección 3: Importes -->
                                                        <details class="app-details">
                                                            <summary class="app-details__summary">Detalles de importes (moneda local)</summary>
                                                            <div class="app-details__content row gx-3">
                                                                <div class="col-md-4 app-form-group">
                                                                    <label class="app-form-label">Neto Gravado</label>
                                                                    <input type="text" class="app-form-control" name="NetoGravado" value="@item.NetoGravado" />
                                                                </div>
                                                                <div class="col-md-4 app-form-group">
                                                                    <label class="app-form-label">No Gravado</label>
                                                                    <input type="text" class="app-form-control" name="NoGravado" value="@item.NoGravado" />
                                                                </div>
                                                                <div class="col-md-4 app-form-group">
                                                                    <label class="app-form-label">Exento</label>
                                                                    <input type="text" class="app-form-control" name="Exento" value="@item.Exento" />
                                                                </div>
                                                                <div class="col-md-4 app-form-group">
                                                                    <label class="app-form-label">IVA Total</label>
                                                                    <input type="text" class="app-form-control" name="Iva" value="@item.Iva" />
                                                                </div>
                                                                <div class="col-md-4 app-form-group">
                                                                    <label class="app-form-label">Total Factura</label>
                                                                    <input type="text" class="app-form-control" name="Total" value="@item.Total" />
                                                                </div>
                                                            </div>
                                                        </details>

                                                        <!-- Sección 4: Desglose IVA -->
                                                        <details class="app-details">
                                                            <summary class="app-details__summary">Desglose de IVA y gravados</summary>
                                                            <div class="app-details__content row gx-3">
                                                                @{
                                                                    var campos = new[]
                                                                    {
                                                                                                                ("Iva0", "IVA 0%", item.Iva0),
                                                                                                                ("Iva5", "IVA 5%", item.Iva5),
                                                                                                                ("Iva105", "IVA 10.5%", item.Iva105),
                                                                                                                ("Iva21", "IVA 21%", item.Iva21),
                                                                                                                ("Iva25", "IVA 2.5%", item.Iva25),
                                                                                                                ("Iva27", "IVA 27%", item.Iva27),
                                                                                                                ("Grav0", "Gravado 0%", item.Grav0),
                                                                                                                ("Grav5", "Gravado 5%", item.Grav5),
                                                                                                                ("Grav105", "Gravado 10.5%", item.Grav105),
                                                                                                                ("Grav21", "Gravado 21%", item.Grav21),
                                                                                                                ("Grav25", "Gravado 2.5%", item.Grav25),
                                                                                                                ("Grav27", "Gravado 27%", item.Grav27)
                                                                                                                };
                                                                }
                                                                @foreach (var (nombre, label, valor) in campos)
                                                                {
                                                                    <div class="col-md-3 app-form-group">
                                                                        <label class="app-form-label">@label</label>
                                                                        <input type="text" class="app-form-control"
                                                                               name="@nombre" value="@valor" />
                                                                    </div>
                                                                }
                                                            </div>
                                                        </details>
                                                    </div>

                                                    <div class="app-modal__footer">
                                                        <button type="button"
                                                                class="app-btn app-btn--success btn-guardar-modal"
                                                                data-id="@item.IdCompra">
                                                            Guardar
                                                        </button>
                                                        <button type="button"
                                                                class="app-btn app-btn--outline"
                                                                data-dismiss="modal">
                                                            Cerrar
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ===================== Correctas ===================== -->
@if (Model.comprasCorrectas.Any())
{
    <div class="app-card app-card--success app-mt-5">
        <div class="app-card__header app-card__header--success">
            <h5 class="app-card__title">
                <i class="fas fa-check-double me-2"></i>
                Facturas cargadas correctamente: @Model.comprasCorrectas.Count()
            </h5>
        </div>
        <div class="app-card__body p-0">
            <div class="table-responsive">
                <table id="comprasCorrectas" class="app-table app-table--striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>P.Venta</th>
                            <th>Nro. Desde</th>
                            <th>Nro. Hasta</th>
                            <th>Tipo Doc. Vend.</th>
                            <th>Nro. Doc. Vend.</th>
                            <th>Denom. Vendedor</th>
                            <th>Tipo Cambio</th>
                            <th>Moneda</th>
                            <th>Neto Gravado</th>
                            <th>No Gravado</th>
                            <th>Exento</th>
                            <th>IVA</th>
                            <th>Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.comprasCorrectas)
                        {
                            <tr>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@Html.DisplayFor(m => item.TipoFact)</td>
                                <td>@Html.DisplayFor(m => item.PuntoVenta)</td>
                                <td>@Html.DisplayFor(m => item.NroDesde)</td>
                                <td>@Html.DisplayFor(m => item.NroHasta)</td>
                                <td>@Html.DisplayFor(m => item.TipoDocVendedor)</td>
                                <td>@Html.DisplayFor(m => item.NroDocVendedor)</td>
                                <td>@Html.DisplayFor(m => item.DenomVendedor)</td>
                                <td>@(item.TipoCambio?.ToString() ?? "N/A")</td>
                                <td>@Html.DisplayFor(m => item.Moneda)</td>
                                <td>@(item.NetoGravado?.ToString("N2") ?? "")</td>
                                <td>@(item.NoGravado?.ToString("N2") ?? "")</td>
                                <td>@(item.Exento?.ToString("N2") ?? "")</td>
                                <td>@(item.Iva?.ToString("N2") ?? "")</td>
                                <td>@(item.Total?.ToString("N2") ?? "")</td>
                                <td class="text-center">
                                    <button type="button"
                                            class="app-btn app-btn--outline app-btn--sm"
                                            data-toggle="modal"
                                            data-target="#modalInfo_@item.IdCompra"
                                            title="+Info">
                                        <i class="fas fa-info-circle"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

