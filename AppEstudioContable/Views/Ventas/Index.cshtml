@model IEnumerable<ServiciosEC.Models.Venta>



@{
    ViewData["Title"] = "Ventas";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
}

<!-- Info del cliente -->
<div class="app-card mb-4">
    <div class="app-card__body text-center">
        <h5 class="mb-0">
            <span class="app-text-muted">Cliente:</span> @ViewBag.RazonSocial
        </h5>
    </div>
</div>

<!-- Filtros -->
<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="app-card">
            <div class="app-card__header">
                <h5 class="app-card__title">
                    <i class="fas fa-calendar-alt me-2"></i> Búsqueda por Período
                </h5>
            </div>
            <div class="app-card__body">
                <div class="row mb-4 justify-content-center">
                    <div class="col-md-4 col-sm-6">
                        <label for="mesInput" class="app-form-label">Mes (MM)</label>
                        <input type="text" id="mesInput" name="mes"
                               class="app-form-control"
                               placeholder="Ej: 01" value="@ViewBag.Mes" />
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <label for="anoInput" class="app-form-label">Año (AAAA)</label>
                        <input type="text" id="anoInput" name="ano"
                               class="app-form-control"
                               placeholder="Ej: 2023" value="@ViewBag.Ano" />
                    </div>
                </div>

                <hr class="mb-4 mt-0" />

                <div class="row justify-content-center app-gap-2">
                    <div class="col-md-6 col-lg-4">
                        <button type="button" id="filtrarListadoBtn"
                                class="app-btn app-btn--outline app-btn--lg app-btn--block">
                            <i class="fas fa-search"></i> Listado de Ventas
                        </button>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <button type="button" id="verTotalesComprobanteBtn"
                                class="app-btn app-btn--success app-btn--lg app-btn--block app-btn--shine">
                            <i class="fas fa-file-invoice"></i> Totales por Comprobante
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Input oculto con el CUIT -->
<input type="hidden" id="clienteCuit" value="@ViewBag.Cuit" />


<!-- Tabla de ventas -->
@if (ViewBag.AnoSeleccionado > 0)
{
    <div class="app-card mt-4">
        <div class="app-card__header">
            <h5 class="app-card__title">Facturas Cargadas</h5>
        </div>
        <div class="app-card__body p-0">
            <div class="table-responsive">
                <table id="tablaVentas" class="app-table app-table--striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo de Factura</th>
                            <th>Punto de Venta</th>
                            <th>Número Desde</th>
                            <th>Número Documento Comprador</th>
                            <th>Denominación Comprador</th>
                            <th>Grav 27%</th>
                            <th>Grav 21%</th>                         
                            <th>Grav 10.5%</th>
                            <th>No Gravado</th>
                            <th>Exento</th>
                            <th>IVA 27%</th>                            
                            <th>IVA 21%</th>
                            <th>IVA 10.5%</th>
                            <th>Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(m => item.Fecha)</td>
                                    <td>@Html.DisplayFor(m => item.TipoFact)</td>
                                    <td>@Html.DisplayFor(m => item.PuntoVenta)</td>
                                    <td>@Html.DisplayFor(m => item.NroDesde)</td>
                                    <td>@Html.DisplayFor(m => item.NroDocComprador)</td>
                                    <td>@Html.DisplayFor(m => item.DenomComprador)</td>
                                    <td>@Html.DisplayFor(m => item.Grav27)</td>                                  
                                    <td>@Html.DisplayFor(m => item.Grav21)</td>
                                    <td>@Html.DisplayFor(m => item.Grav105)</td>
                                    <td>@Html.DisplayFor(m => item.NoGravado)</td>
                                    <td>@Html.DisplayFor(m => item.Exento)</td>
                                    <td>@Html.DisplayFor(m => item.Iva27)</td>                                   
                                    <td>@Html.DisplayFor(m => item.Iva21)</td>
                                    <td>@Html.DisplayFor(m => item.Iva105)</td>
                                    <td>@Html.DisplayFor(m => item.Total)</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.IdVenta"
                                               asp-route-cuit="@ViewBag.Cuit"
                                               class="app-btn app-btn--outline app-btn--sm" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Details"
                                               asp-route-id="@item.IdVenta"
                                               asp-route-cuit="@ViewBag.Cuit"
                                               class="app-btn app-btn--info app-btn--sm" title="Detalle">
                                                <i class="fas fa-info-circle"></i>
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-id="@item.IdVenta"
                                               asp-route-cuit="@ViewBag.Cuit"
                                               class="app-btn app-btn--danger app-btn--sm" title="Eliminar">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="app-alert app-alert--warning mt-4">
            No hay ventas cargadas para el cliente con CUIT: <strong>@ViewBag.Cuit</strong>
            @(ViewBag.MesSeleccionado > 0 ? $" en el mes {ViewBag.MesSeleccionado}" : "")
            @(ViewBag.AnoSeleccionado > 0 ? $" del año {ViewBag.AnoSeleccionado}" : "").
        </div>
    }
}


<!-- Botón Volver -->
<div class="app-mt-4">
    <a asp-controller="Cliente"
       asp-action="Details"
       asp-route-id="@ViewBag.Id"
       class="app-btn app-btn--outline">
        <i class="fas fa-arrow-left"></i> Volver
    </a>
</div>


@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="~/js/ventas.js" asp-append-version="true"></script>
}