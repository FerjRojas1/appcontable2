@model AppEstudioContable.Models.VentaViewModel



@{
    ViewData["Title"] = "Gestión de Ventas";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
}

<!-- Info del cliente -->
<div class="app-card mb-4">
    <div class="app-card__body text-center">
        <h5 class="mb-0">
            <span class="app-text-muted">Cliente:</span> @ViewBag.RazonSocial
        </h5>
    </div>
</div>


<!-- Panel de importación / carga manual -->
<div class="row">
    <!-- Importar desde Excel -->
    <div class="col-md-6">
        <div class="app-card h-100">
            <div class="app-card__header">
                <h5 class="app-card__title">
                    <i class="fas fa-file-excel me-2"></i> Importar Ventas desde Excel
                </h5>
            </div>
            <div class="app-card__body">
                <p class="app-text-muted app-mb-4">Carga masiva de ventas mediante un archivo Excel.</p>

                <form id="formCargaExcel"
                      asp-controller="Ventas"
                      asp-action="Altas"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="app-form-group">
                        <label for="file" class="app-form-label">
                            Seleccioná un archivo
                            <small class="app-text-muted">(formatos .xlsx, .xls, .csv)</small>
                        </label>

                        <div class="app-file">
                            <input type="file" name="file" id="file"
                                   accept=".xlsx,.xls,.csv"
                                   class="app-form-control" required />
                            <label class="app-file__label" for="file">
                                <i class="fas fa-cloud-upload-alt me-2"></i>
                                <span class="app-file__text">Elegir archivo</span>
                            </label>
                        </div>

                        <div class="app-form-error" id="fileError"></div>
                        <div class="app-form-error" id="fileValidationError" style="display:none;">
                            Por favor, seleccioná un archivo válido de Excel.
                        </div>
                    </div>

                    <input type="hidden" name="id" value="@Model.id" />

                    @Html.ValidationSummary(true, "", new { @class = "app-alert app-alert--danger mt-3" })

                    <button type="submit" id="btnCargar"
                            class="app-btn app-btn--primary app-btn--lg app-btn--block app-btn--shine app-mt-4">
                        <i class="fas fa-upload me-2"></i> Cargar Ventas
                    </button>

                    <!-- Modal de carga -->
                    <div class="modal fade" id="modalCargando" tabindex="-1"
                         aria-labelledby="modalCargandoLabel" aria-hidden="true"
                         data-backdrop="static" data-keyboard="false">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content app-modal app-modal--loading">
                                <div class="app-modal__body text-center">
                                    <div class="app-spinner">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="sr-only">Cargando...</span>
                                        </div>
                                    </div>
                                    <h5 class="mb-0 app-text-muted">Procesando archivo, por favor esperá...</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Carga manual -->
    <div class="col-md-6">
        <div class="app-card h-100">
            <div class="app-card__header">
                <h5 class="app-card__title">
                    <i class="fas fa-plus-circle me-2"></i> Cargar Venta Manual
                </h5>
            </div>
            <div class="app-card__body app-flex-between" style="flex-direction: column;">
                <p class="app-text-muted app-mb-4">
                    Ingresá una nueva venta manualmente, completando todos los detalles.
                </p>
                <form asp-controller="Ventas" asp-action="Create" method="get" class="w-100">
                    <input type="hidden" name="id" value="@Model.id" />
                    <button type="submit" class="app-btn app-btn--info app-btn--lg app-btn--block app-btn--shine">
                        <i class="fas fa-pencil-alt me-2"></i> Nueva Venta
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===================== Facturas para revisar ===================== -->
@if (Model.ventasParaRevisar != null && Model.ventasParaRevisar.Any())
{
    <div class="app-card app-card--warning app-mt-5">
        <div class="app-card__header app-card__header--warning">
            <h5 class="app-card__title">
                <i class="fas fa-exclamation-circle me-2"></i>
                Facturas para revisar: @Model.ventasParaRevisar.Count()
            </h5>
        </div>
        <div class="app-card__body p-0">
            <div class="table-responsive">
                <table id="ventasParaRevisar" class="app-table app-table--striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo de Factura</th>
                            <th>Punto de Venta</th>
                            <th>Número Desde</th>
                            <th>Número Documento Comprador</th>
                            <th>Denominación Comprador</th>
                            <th>Moneda</th>
                            <th>Neto Gravado</th>
                            <th>IVA</th>
                            <th>Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ventasParaRevisar)
                        {
                            <tr data-id="@item.IdVenta">
                                <td>@Html.DisplayFor(m => item.Fecha)</td>
                                <td>@Html.DisplayFor(m => item.TipoFact)</td>
                                <td>@Html.DisplayFor(m => item.PuntoVenta)</td>
                                <td>@Html.DisplayFor(m => item.NroDesde)</td>
                                <td>@Html.DisplayFor(m => item.NroDocComprador)</td>
                                <td>@Html.DisplayFor(m => item.DenomComprador)</td>
                                <td>@Html.DisplayFor(m => item.Moneda)</td>
                                <td>@Html.DisplayFor(m => item.NetoGravado)</td>
                                <td>@Html.DisplayFor(m => item.Iva)</td>
                                <td>@Html.DisplayFor(m => item.Total)</td>
                                <td class="text-center">
                                    <button type="button"
                                            class="app-btn app-btn--outline app-btn--sm"
                                            data-toggle="modal"
                                            data-target="#modalEdit_@item.IdVenta"
                                            title="Editar venta">
                                        <i class="fas fa-edit"></i>
                                    </button>

                                    <!-- Modal edición -->
                                    <div class="modal fade" id="modalEdit_@item.IdVenta" tabindex="-1"
                                         aria-labelledby="modalLabelEdit_@item.IdVenta" aria-hidden="true">
                                        <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                            <div class="modal-content app-modal">
                                                <form method="post" action="/Ventas/Edit2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="IdVenta" value="@item.IdVenta" />

                                                    <div class="app-modal__header app-modal__header--info">
                                                        <h5 class="app-modal__title" id="modalLabelEdit_@item.IdVenta">
                                                            <i class="fas fa-pencil-alt me-2"></i>
                                                            Editar Venta #@item.IdVenta
                                                        </h5>
                                                    </div>                                                   

                                                    <div class="app-modal__body">
                                                        <!-- Datos principales -->
                                                        <details class="app-details" open>
                                                            <summary class="app-details__summary">Datos principales de la venta</summary>
                                                            <div class="app-details__content row gx-3">
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="Fecha_@item.IdVenta">Fecha</label>
                                                                    <input type="date" class="app-form-control"
                                                                           id="Fecha_@item.IdVenta" name="Fecha"
                                                                           value="@item.Fecha.ToString("yyyy-MM-dd")" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="TipoFact_@item.IdVenta">Tipo Factura</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="TipoFact_@item.IdVenta" name="TipoFact"
                                                                           value="@item.TipoFact" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="PuntoVenta_@item.IdVenta">Punto de Venta</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="PuntoVenta_@item.IdVenta" name="PuntoVenta"
                                                                           value="@item.PuntoVenta" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="NroDesde_@item.IdVenta">Número Desde</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="NroDesde_@item.IdVenta" name="NroDesde"
                                                                           value="@item.NroDesde" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="NroHasta_@item.IdVenta">Número Hasta</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="NroHasta_@item.IdVenta" name="NroHasta"
                                                                           value="@item.NroHasta" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="Moneda_@item.IdVenta">Moneda</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="Moneda_@item.IdVenta" name="Moneda"
                                                                           value="@item.Moneda" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="TipoCambio_@item.IdVenta">Tipo de Cambio</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="TipoCambio_@item.IdVenta" name="TipoCambio"
                                                                           value="@item.TipoCambio" required />
                                                                </div>
                                                            </div>
                                                        </details>

                                                        <!-- Datos del comprador -->
                                                        <details class="app-details">
                                                            <summary class="app-details__summary">Datos del comprador</summary>
                                                            <div class="app-details__content row gx-3">
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="DenomComprador_@item.IdVenta">Denominación Comprador</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="DenomComprador_@item.IdVenta" name="DenomComprador"
                                                                           value="@item.DenomComprador" />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="TipoDocComprador_@item.IdVenta">Tipo Documento</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="TipoDocComprador_@item.IdVenta" name="TipoDocComprador"
                                                                           value="@item.TipoDocComprador" required />
                                                                </div>
                                                                <div class="col-md-6 app-form-group">
                                                                    <label class="app-form-label" for="NroDocComprador_@item.IdVenta">Número Documento</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="NroDocComprador_@item.IdVenta" name="NroDocComprador"
                                                                           value="@item.NroDocComprador" required />
                                                                </div>
                                                            </div>
                                                        </details>

                                                        <!-- Importes -->
                                                        <details class="app-details">
                                                            <summary class="app-details__summary">Detalles de importes (moneda local)</summary>
                                                            <div class="app-details__content row gx-3">
                                                                <div class="col-md-4 app-form-group">
                                                                    <label class="app-form-label" for="NetoGravado_@item.IdVenta">Neto Gravado</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="NetoGravado_@item.IdVenta" name="NetoGravado"
                                                                           value="@item.NetoGravado" />
                                                                </div>
                                                                <div class="col-md-4 app-form-group">
                                                                    <label class="app-form-label" for="NoGravado_@item.IdVenta">No Gravado</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="NoGravado_@item.IdVenta" name="NoGravado"
                                                                           value="@item.NoGravado" />
                                                                </div>
                                                                <div class="col-md-4 app-form-group">
                                                                    <label class="app-form-label" for="Exento_@item.IdVenta">Exento</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="Exento_@item.IdVenta" name="Exento"
                                                                           value="@item.Exento" />
                                                                </div>
                                                                <div class="col-md-4 app-form-group">
                                                                    <label class="app-form-label" for="Iva_@item.IdVenta">IVA Total</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="Iva_@item.IdVenta" name="Iva"
                                                                           value="@item.Iva" />
                                                                </div>
                                                                <div class="col-md-4 app-form-group">
                                                                    <label class="app-form-label" for="Total_@item.IdVenta">Total Factura</label>
                                                                    <input type="text" class="app-form-control"
                                                                           id="Total_@item.IdVenta" name="Total"
                                                                           value="@item.Total" />
                                                                </div>
                                                            </div>
                                                        </details>

                                                        <!-- Desglose IVA -->
                                                        <details class="app-details">
                                                            <summary class="app-details__summary">Desglose de IVA y gravados por alícuota</summary>
                                                            <div class="app-details__content row gx-3">
                                                                @{
                                                                    var campos = new[]
                                                                    {
                                                                                                                ("Iva0", "IVA 0%", item.Iva0),
                                                                                                                ("Iva5", "IVA 5%", item.Iva5),
                                                                                                                ("Iva105", "IVA 10.5%", item.Iva105),
                                                                                                                ("Iva21", "IVA 21%", item.Iva21),
                                                                                                                ("Iva25", "IVA 2.5%", item.Iva25),
                                                                                                                ("Iva27", "IVA 27%", item.Iva27),
                                                                                                                ("Grav0", "Gravado 0%", item.Grav0),
                                                                                                                ("Grav5", "Gravado 5%", item.Grav5),
                                                                                                                ("Grav105", "Gravado 10.5%", item.Grav105),
                                                                                                                ("Grav21", "Gravado 21%", item.Grav21),
                                                                                                                ("Grav25", "Gravado 2.5%", item.Grav25),
                                                                                                                ("Grav27", "Gravado 27%", item.Grav27)
                                                                                                                };
                                                                }
                                                                @foreach (var (nombre, label, valor) in campos)
                                                                {
                                                                    <div class="col-md-3 app-form-group">
                                                                        <label class="app-form-label">@label</label>
                                                                        <input type="text" class="app-form-control"
                                                                               name="@nombre" value="@valor" />
                                                                    </div>
                                                                }
                                                            </div>
                                                        </details>
                                                    </div>

                                                    <div class="app-modal__footer">
                                                        <button type="button"
                                                                class="app-btn app-btn--success btn-guardar-modal"
                                                                data-id="@item.IdVenta">
                                                            Guardar
                                                        </button>
                                                        <button type="button"
                                                                class="app-btn app-btn--outline"
                                                                data-dismiss="modal">
                                                            Cerrar
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ===================== Correctas ===================== -->
@if (Model.ventasCorrectas.Any())
{
    <div class="app-card app-card--success app-mt-5">
        <div class="app-card__header app-card__header--success">
            <h5 class="app-card__title">
                <i class="fas fa-check-double me-2"></i>
                Facturas cargadas correctamente: @Model.ventasCorrectas.Count()
            </h5>
        </div>
        <div class="app-card__body p-0">
            <div class="table-responsive">
                <table id="ventasCorrectas" class="app-table app-table--striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo de Factura</th>
                            <th>Punto de Venta</th>
                            <th>Número Desde</th>
                            <th>Número Documento Comprador</th>
                            <th>Denominación Comprador</th>
                            <th>Moneda</th>
                            <th>Neto Gravado</th>
                            <th>IVA</th>
                            <th>Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ventasCorrectas)
                        {
                            <tr>
                                <td>@Html.DisplayFor(m => item.Fecha)</td>
                                <td>@Html.DisplayFor(m => item.TipoFact)</td>
                                <td>@Html.DisplayFor(m => item.PuntoVenta)</td>
                                <td>@Html.DisplayFor(m => item.NroDesde)</td>
                                <td>@Html.DisplayFor(m => item.NroDocComprador)</td>
                                <td>@Html.DisplayFor(m => item.DenomComprador)</td>
                                <td>@Html.DisplayFor(m => item.Moneda)</td>
                                <td>@Html.DisplayFor(m => item.NetoGravado)</td>
                                <td>@Html.DisplayFor(m => item.Iva)</td>
                                <td>@Html.DisplayFor(m => item.Total)</td>
                                <td class="text-center">
                                    <button type="button"
                                            class="app-btn app-btn--outline app-btn--sm"
                                            data-toggle="modal"
                                            data-target="#modalInfo_@item.IdVenta"
                                            title="+Info">
                                        <i class="fas fa-info-circle"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ===================== Fallidas ===================== -->
@if (Model.ventasFallidas.Any())
{
    <div class="app-card app-card--danger app-mt-5">
        <div class="app-card__header app-card__header--danger">
            <h5 class="app-card__title">
                <i class="fas fa-times-circle me-2"></i>
                Facturas que no se agregaron: @Model.ventasFallidas.Count()
            </h5>
        </div>
        <div class="app-card__body p-0">
            <div class="table-responsive">
                <table id="ventasFallidas" class="app-table app-table--striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo de Factura</th>
                            <th>Punto de Venta</th>
                            <th>Número Desde</th>
                            <th>Número Documento Comprador</th>
                            <th>Denominación Comprador</th>
                            <th>Moneda</th>
                            <th>Neto Gravado</th>
                            <th>IVA</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ventasParaRevisar)
                        {
                        <td>@item.Fecha</td>
                        <td>@item.TipoFact</td>
                        <td>@item.PuntoVenta</td>
                        <td>@item.NroDesde</td>
                        <td>@item.NroDocComprador</td>
                        <td>@item.DenomComprador</td>
                        <td>@item.Moneda</td>
                        <td>@item.NetoGravado</td>
                        <td>@item.Iva</td>
                        <td>@item.Total</td>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Botón volver -->
<div class="app-mt-4">
    <a asp-controller="Cliente"
       asp-action="Details"
       asp-route-id="@Model.id"
       class="app-btn app-btn--outline">
        <i class="fas fa-arrow-left"></i> Volver
    </a>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="~/js/ventas.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
