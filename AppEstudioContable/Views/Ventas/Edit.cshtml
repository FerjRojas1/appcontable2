@model AppEstudioContable.Models.VentaModel

@{
    ViewData["Title"] = "Editar Venta";
}

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-secondary shadow-sm">
            <div class="card-header bg-white border-bottom-0">
                <h3 class="card-title text-dark font-weight-bold">
                    <i class="fas fa-edit mr-2 text-secondary"></i> Editar Venta
                </h3>
            </div>

            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="app-alert app-alert--danger @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

                    <input type="hidden" asp-for="IdVenta" />
                    <input type="hidden" name="cuit" value="@ViewBag.Cuit" />
                    <input type="hidden" name="IdCliente" value="@Model.id" />

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="Fecha" class="text-muted"></label>
                            <input asp-for="Fecha" class="form-control" type="date" />
                            <span asp-validation-for="Fecha" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="TipoFact" class="text-muted"></label>
                            <input asp-for="TipoFact" class="form-control" />
                            <span asp-validation-for="TipoFact" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label asp-for="PuntoVenta" class="text-muted"></label>
                            <input asp-for="PuntoVenta" class="form-control" />
                            <span asp-validation-for="PuntoVenta" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="NroDesde" class="text-muted"></label>
                            <input asp-for="NroDesde" class="form-control" />
                            <span asp-validation-for="NroDesde" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="NroHasta" class="text-muted"></label>
                            <input asp-for="NroHasta" class="form-control" />
                            <span asp-validation-for="NroHasta" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label asp-for="TipoDocComprador" class="text-muted"></label>
                            <input asp-for="TipoDocComprador" class="form-control" />
                            <span asp-validation-for="TipoDocComprador" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="NroDocComprador" class="text-muted"></label>
                            <input asp-for="NroDocComprador" class="form-control" />
                            <span asp-validation-for="NroDocComprador" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="DenomComprador" class="text-muted"></label>
                            <input asp-for="DenomComprador" class="form-control" />
                            <span asp-validation-for="DenomComprador" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="TipoCambio" class="text-muted"></label>
                            <input asp-for="TipoCambio" class="form-control" />
                            <span asp-validation-for="TipoCambio" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="Moneda" class="text-muted"></label>
                            <input asp-for="Moneda" class="form-control" />
                            <span asp-validation-for="Moneda" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />
                    <h5 class="mt-3 mb-3">Desglose de Gravados</h5>
                    <div class="form-row">
                        <div class="form-group col-md-2">
                            <label asp-for="Grav0" class="text-muted">Gravado 0%</label>
                            <input asp-for="Grav0" class="form-control currency-input" type="text" inputmode="decimal" />
                            <span asp-validation-for="Grav0" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-2">
                            <label asp-for="Grav25" class="text-muted">Gravado 2.5%</label>
                            <input asp-for="Grav25" class="form-control currency-input" type="text" inputmode="decimal" />
                            <span asp-validation-for="Grav25" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-2">
                            <label asp-for="Grav5" class="text-muted">Gravado 5%</label>
                            <input asp-for="Grav5" class="form-control currency-input" type="text" inputmode="decimal" />
                            <span asp-validation-for="Grav5" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-2">
                            <label asp-for="Grav105" class="text-muted">Gravado 10.5%</label>
                            <input asp-for="Grav105" class="form-control currency-input" type="text" inputmode="decimal" />
                            <span asp-validation-for="Grav105" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-2">
                            <label asp-for="Grav21" class="text-muted">Gravado 21%</label>
                            <input asp-for="Grav21" class="form-control currency-input" type="text" inputmode="decimal" />
                            <span asp-validation-for="Grav21" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-2">
                            <label asp-for="Grav27" class="text-muted">Gravado 27%</label>
                            <input asp-for="Grav27" class="form-control currency-input" type="text" inputmode="decimal" />
                            <span asp-validation-for="Grav27" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />
                    <h5 class="mt-3 mb-3">Desglose de IVA</h5>
                    <div class="row">
                        <div class="col-md-3 form-group">
                            <label asp-for="Iva0" class="control-label">IVA 0%</label>
                            <input asp-for="Iva0" class="form-control bg-light currency-input" type="text" inputmode="decimal" readonly />
                            <span asp-validation-for="Iva0" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="Iva25" class="control-label">IVA 2.5%</label>
                            <input asp-for="Iva25" class="form-control bg-light currency-input" type="text" inputmode="decimal" readonly />
                            <span asp-validation-for="Iva25" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="Iva5" class="control-label">IVA 5%</label>
                            <input asp-for="Iva5" class="form-control bg-light currency-input" type="text" inputmode="decimal" readonly />
                            <span asp-validation-for="Iva5" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="Iva105" class="control-label">IVA 10.5%</label>
                            <input asp-for="Iva105" class="form-control bg-light currency-input" type="text" inputmode="decimal" readonly />
                            <span asp-validation-for="Iva105" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="Iva21" class="control-label">IVA 21%</label>
                            <input asp-for="Iva21" class="form-control bg-light currency-input" type="text" inputmode="decimal" readonly />
                            <span asp-validation-for="Iva21" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="Iva27" class="control-label">IVA 27%</label>
                            <input asp-for="Iva27" class="form-control bg-light currency-input" type="text" inputmode="decimal" readonly />
                            <span asp-validation-for="Iva27" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />
                    <h5 class="mt-3 mb-3">Totales Generales</h5>
                    <div class="row">
                        <div class="col-md-3 form-group">
                            <label asp-for="NetoGravado" class="control-label">Neto Gravado</label>
                            <input asp-for="NetoGravado" class="form-control bg-light currency-input" type="text" inputmode="decimal" readonly />
                            <span asp-validation-for="NetoGravado" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="NoGravado" class="control-label">No Gravado</label>
                            <input asp-for="NoGravado" class="form-control currency-input" type="text" inputmode="decimal" />
                            <span asp-validation-for="NoGravado" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="Exento" class="control-label">Exento</label>
                            <input asp-for="Exento" class="form-control currency-input" type="text" inputmode="decimal" />
                            <span asp-validation-for="Exento" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="Iva" class="control-label">IVA Total</label>
                            <input asp-for="Iva" class="form-control bg-light currency-input" type="text" inputmode="decimal" readonly />
                            <span asp-validation-for="Iva" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="Total" class="control-label">Total del Comprobante</label>
                            <input asp-for="Total" class="form-control bg-light currency-input" type="text" inputmode="decimal" readonly />
                            <span asp-validation-for="Total" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" asp-route-cuit="@ViewBag.Cuit" class="btn btn-outline-secondary btn-shine">
                            <i class="fas fa-arrow-left mr-1"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-primary btn-shine">
                            <i class="fas fa-save mr-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/currency-helper.js" asp-append-version="true"></script>
    <script src="~/js/venta-manual.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}