@model Dictionary<string, ServiciosEC.Utilidades.ModelosDTO.TotalesIVA>
@{
    ViewData["Title"] = "Totales por Comprobante — Ventas";
}

<div class="text-center app-mt-4 app-mb-4">
    <h2 class="app-title">
        <i class="fas fa-file-invoice-dollar me-2"></i>
        Totales por Tipo de Comprobante — Ventas
    </h2>
</div>

@if (Model == null || !Model.Any())
{
    <!-- 🔴 ESTADO VACÍO -->
    <div class="app-empty">
        <i class="fas fa-inbox"></i>
        <h4>No hay ventas cargadas en el período</h4>
        <p>
            No se encontraron comprobantes para el CUIT <strong>@ViewBag.Cuit</strong>
            @if (ViewBag.MesSeleccionado > 0)
            {
                <text> en el mes <strong>@ViewBag.MesSeleccionado</strong></text>
            }
            @if (ViewBag.AnoSeleccionado > 0)
            {
                <text> del año <strong>@ViewBag.AnoSeleccionado</strong></text>
            }
    .
        </p>
        <a asp-controller="Ventas"
           asp-action="Index"
           asp-route-cuit="@ViewBag.Cuit"
           class="app-btn app-btn--primary app-mt-4">
            <i class="fas fa-arrow-left"></i> Volver a Ventas
        </a>
    </div>
}
else
{

@foreach (var item in Model)
{
    <div class="app-card app-mb-4">
        <div class="app-card__header">
            <h5 class="app-card__title">
                <i class="fas fa-file-invoice-dollar me-2"></i>
                Factura Tipo: <strong>@item.Key</strong>
            </h5>
        </div>
        <div class="app-card__body p-0">
            <div class="table-responsive">
                <table class="app-table app-table--striped">
                    <thead>
                        <tr>
                            <th>Gravado 27%</th>
                            <th>Gravado 21%</th>
                            <th>Gravado 10.5%</th>
                            <th>Exento</th>
                            <th>No gravado</th>
                            <th>IVA 27%</th>
                            <th>IVA 21%</th>
                            <th>IVA 10.5%</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@item.Value.Neto27.ToString("C")</td>
                            <td>@item.Value.Neto21.ToString("C")</td>
                            <td>@item.Value.Neto105.ToString("C")</td>
                            <td>@item.Value.Exento.ToString("C")</td>
                            <td>@item.Value.NoGravado.ToString("C")</td>
                            <td>@item.Value.Iva27.ToString("C")</td>
                            <td>@item.Value.Iva21.ToString("C")</td>
                            <td>@item.Value.Iva105.ToString("C")</td>
                            <td class="app-table__totals">@item.Value.TotalGeneral.ToString("C")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="app-mt-4">
    <a asp-controller="Ventas"
       asp-action="Index"
       asp-route-cuit="@ViewBag.Cuit"
       class="app-btn app-btn--outline">
        <i class="fas fa-arrow-left"></i> Volver
    </a>
</div>

}                          