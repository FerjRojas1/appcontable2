@using System.Globalization
@model AppEstudioContable.Models.GananciasModel

@{
    ViewData["Title"] = "Libro IVA";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string[] meses = new[] {
        "ENERO", "FEBRERO", "MARZO", "ABRIL", "MAYO", "JUNIO",
        "JULIO", "AGOSTO", "SEPTIEMBRE", "OCTUBRE", "NOVIEMBRE", "DICIEMBRE"
    };
    var cultura = new CultureInfo("es-AR");
}

<!-- Info del cliente -->
<div class="app-card mb-4">
    <div class="app-card__body text-center">
        <h5 class="mb-0">
            <span class="app-text-muted">Cliente :</span> @ViewBag.RazonSocial
        </h5>
    </div>
</div>

<!-- Botón Imprimir -->
<div class="text-right mb-3" id="no-print">
    <a class="app-btn app-btn--outline app-btn--sm" href="#" onclick="window.print();">
        <i class="fas fa-print me-1"></i> Imprimir
    </a>
</div>

<section class="content">
    <div class="container-fluid">

        <!-- ===================== Cards de totales ===================== -->
        <div class="row justify-content-center mb-4">
            <!-- Card Compras -->
            <div class="col-md-6 mb-3">
                <div class="app-card app-card--compras">
                    <div class="app-card__body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="app-text-muted mb-1">
                                    <i class="fas fa-shopping-cart me-2"></i> Total Compras del Año
                                </h6>
                                <small class="app-text-muted">Neto + IVA</small>
                            </div>
                            <h3 class="app-h3 app-text-compras">
                                @Model.Compras.TotalAnual.TotalGeneral.ToString("C2", cultura)
                            </h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card Ventas -->
            <div class="col-md-6 mb-3">
                <div class="app-card app-card--ventas">
                    <div class="app-card__body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="app-text-muted mb-1">
                                    <i class="fas fa-file-invoice me-2"></i> Total Ventas del Año
                                </h6>
                                <small class="app-text-muted">Neto + IVA</small>
                            </div>
                            <h3 class="app-h3 app-text-ventas">
                                @Model.Ventas.TotalAnual.TotalGeneral.ToString("C2", cultura)
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===================== Acordeón ===================== -->
        <div class="row justify-content-center">
            <div class="col-md-11">
                <div id="accordion">

                    <!-- CARD COMPRAS -->
                    <div class="app-card app-card--compras mb-4">
                        <div class="app-card__header app-card__header--compras"
                             data-toggle="collapse" href="#collapseCompras"
                             style="cursor: pointer;">
                            <h5 class="app-card__title">
                                <i class="fas fa-shopping-cart me-2"></i> COMPRAS
                            </h5>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div id="collapseCompras" class="collapse show" data-parent="#accordion">
                            <div class="app-card__body p-0">
                                <div class="table-responsive">
                                    <table class="app-table app-table--striped app-table--compras">
                                        <thead>
                                            <tr>
                                                <th>Mes</th>
                                                <th>Grav 27%</th>
                                                <th>Grav 21%</th>
                                                <th>Grav 10.5%</th>
                                                <th>IVA 27%</th>
                                                <th>IVA 21%</th>
                                                <th>IVA 10.5%</th>
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < 12; i++)
                                            {
                                                <tr>
                                                    <td>@meses[i]</td>
                                                    <td>@Model.Compras.PorMes[i].Neto27.ToString("C2", cultura)</td>
                                                    <td>@Model.Compras.PorMes[i].Neto21.ToString("C2", cultura)</td>
                                                    <td>@Model.Compras.PorMes[i].Neto105.ToString("C2", cultura)</td>
                                                    <td>@Model.Compras.PorMes[i].Iva27.ToString("C2", cultura)</td>
                                                    <td>@Model.Compras.PorMes[i].Iva21.ToString("C2", cultura)</td>
                                                    <td>@Model.Compras.PorMes[i].Iva105.ToString("C2", cultura)</td>
                                                    <td>@Model.Compras.PorMes[i].TotalGeneral.ToString("C2", cultura)</td>
                                                </tr>
                                            }
                                            <tr class="app-table__totals">
                                                <td><strong>TOTALES</strong></td>
                                                <td>@Model.Compras.TotalAnual.Neto27.ToString("C2", cultura)</td>
                                                <td>@Model.Compras.TotalAnual.Neto21.ToString("C2", cultura)</td>
                                                <td>@Model.Compras.TotalAnual.Neto105.ToString("C2", cultura)</td>
                                                <td>@Model.Compras.TotalAnual.Iva27.ToString("C2", cultura)</td>
                                                <td>@Model.Compras.TotalAnual.Iva21.ToString("C2", cultura)</td>
                                                <td>@Model.Compras.TotalAnual.Iva105.ToString("C2", cultura)</td>
                                                <td>@Model.Compras.TotalAnual.TotalGeneral.ToString("C2", cultura)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CARD VENTAS -->
                    <div class="app-card app-card--ventas mb-4">
                        <div class="app-card__header app-card__header--ventas"
                             data-toggle="collapse" href="#collapseVentas"
                             style="cursor: pointer;">
                            <h5 class="app-card__title">
                                <i class="fas fa-file-invoice me-2"></i> VENTAS
                            </h5>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div id="collapseVentas" class="collapse show" data-parent="#accordion">
                            <div class="app-card__body p-0">
                                <div class="table-responsive">
                                    <table class="app-table app-table--striped app-table--ventas">
                                        <thead>
                                            <tr>
                                                <th>Mes</th>
                                                <th>Grav 27%</th>
                                                <th>Grav 21%</th>
                                                <th>Grav 10.5%</th>
                                                <th>IVA 27%</th>
                                                <th>IVA 21%</th>
                                                <th>IVA 10.5%</th>
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < 12; i++)
                                            {
                                                <tr>
                                                    <td>@meses[i]</td>
                                                    <td>@Model.Ventas.PorMes[i].Neto27.ToString("C2", cultura)</td>
                                                    <td>@Model.Ventas.PorMes[i].Neto21.ToString("C2", cultura)</td>
                                                    <td>@Model.Ventas.PorMes[i].Neto105.ToString("C2", cultura)</td>
                                                    <td>@Model.Ventas.PorMes[i].Iva27.ToString("C2", cultura)</td>
                                                    <td>@Model.Ventas.PorMes[i].Iva21.ToString("C2", cultura)</td>
                                                    <td>@Model.Ventas.PorMes[i].Iva105.ToString("C2", cultura)</td>
                                                    <td>@Model.Ventas.PorMes[i].TotalGeneral.ToString("C2", cultura)</td>
                                                </tr>
                                            }
                                            <tr class="app-table__totals">
                                                <td><strong>TOTALES</strong></td>
                                                <td>@Model.Ventas.TotalAnual.Neto27.ToString("C2", cultura)</td>
                                                <td>@Model.Ventas.TotalAnual.Neto21.ToString("C2", cultura)</td>
                                                <td>@Model.Ventas.TotalAnual.Neto105.ToString("C2", cultura)</td>
                                                <td>@Model.Ventas.TotalAnual.Iva27.ToString("C2", cultura)</td>
                                                <td>@Model.Ventas.TotalAnual.Iva21.ToString("C2", cultura)</td>
                                                <td>@Model.Ventas.TotalAnual.Iva105.ToString("C2", cultura)</td>
                                                <td>@Model.Ventas.TotalAnual.TotalGeneral.ToString("C2", cultura)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div> <!-- /#accordion -->
            </div>
        </div>
    </div>
</section>

<!-- Botón Volver -->
<div class="app-mt-4">
    <a asp-controller="Cliente"
       asp-action="Details"
       asp-route-id="@ViewBag.Id"
       class="app-btn app-btn--outline">
        <i class="fas fa-arrow-left me-2"></i> Volver
    </a>
</div>