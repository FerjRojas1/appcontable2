<!-- Main Sidebar Container -->
<aside class="main-sidebar sidebar-dark-primary elevation-4 app-sidebar">
    <!-- Brand Logo -->
    <a class="brand-link text-center py-3" asp-controller="Home" asp-action="Index">
        <span class="brand-text fw-semibold fs-5">AppContable</span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Sidebar Menu -->
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column"
                data-widget="treeview"
                role="menu"
                data-accordion="false">

                <!-- Inicio -->
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="nav-icon bi bi-house-door-fill"></i>
                        <p>Inicio</p>
                    </a>
                </li>

                <!-- Clientes -->
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Cliente" asp-action="Index">
                        <i class="nav-icon bi bi-people-fill"></i>
                        <p>Clientes</p>
                    </a>
                </li>

                <!-- Usuarios -->
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Usuarios" asp-action="Index">
                        <i class="nav-icon bi bi-person-badge-fill"></i>
                        <p>Usuarios</p>
                    </a>
                </li>

                <!-- Calendario -->
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="nav-icon bi bi-calendar-event"></i>
                        <p>Calendario</p>
                    </a>
                </li>

                <!-- Auditoría (solo Admin) -->
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="Auditoria" asp-action="Index">
                            <i class="nav-icon bi bi-shield-lock-fill"></i>
                            <p>Ver Auditoría</p>
                        </a>
                    </li>
                }

            </ul>
        </nav>
    </div>
</aside>