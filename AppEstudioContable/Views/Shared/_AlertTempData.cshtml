@{
    var success = TempData["MensajeExito"] as string ?? TempData["SuccessMessage"] as string ?? TempData["MensajeExitoCarga"] as string;
    var error = TempData["MensajeError"] as string ?? TempData["ErrorMessage"] as string;
    var info = TempData["MensajeInfo"] as string ?? TempData["InfoMessage"] as string;
    var warning = TempData["MensajeWarning"] as string;
}

@if (!string.IsNullOrEmpty(success))
{
    <div class="app-alert app-alert--success app-alert--dismissible app-mt-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        <strong>¡Listo!</strong> @success
        <button type="button" class="app-alert__close" data-dismiss="alert" aria-label="Cerrar">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="app-alert app-alert--danger app-alert--dismissible app-mt-4" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        <strong>Error:</strong> @error
        <button type="button" class="app-alert__close" data-dismiss="alert" aria-label="Cerrar">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(warning))
{
    <div class="app-alert app-alert--warning app-alert--dismissible app-mt-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Atención:</strong> @warning
        <button type="button" class="app-alert__close" data-dismiss="alert" aria-label="Cerrar">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(info))
{
    <div class="app-alert app-alert--info app-alert--dismissible app-mt-4" role="alert">
        <i class="fas fa-info-circle me-2"></i>
        <strong>Info:</strong> @info
        <button type="button" class="app-alert__close" data-dismiss="alert" aria-label="Cerrar">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}