<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppContable</title>

    <!-- Fuente -->
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@300;400;600;700&display=swap" rel="stylesheet" />

    <!-- AdminLTE (base) -->
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/adminlte/dist/css/adminlte.min.css" asp-append-version="true" />

    <!-- Bootstrap Icons (CDN, no necesita asp-append-version) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
          crossorigin="anonymous" />

    <!-- Design System del proyecto -->
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/overrides.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

 
</head>

<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <!-- Navbar -->
        <partial name="_Navbar" />

        <!-- Sidebar -->
        <partial name="_Sidebar" />

        <!-- Content Wrapper -->
        <div class="content-wrapper">

            <!-- Header opcional (navbar de cliente, breadcrumbs, etc.) -->
            @await RenderSectionAsync("ClienteNavbar", required: false)

            <!-- Contenido de la vista -->
            <section class="content">
                <div class="container-fluid">
                    <partial name="_AlertTempData" />
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Footer -->
        <partial name="_Footer" />

    </div>

    <!-- Scripts base -->
    <script src="~/adminlte/plugins/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/adminlte/dist/js/adminlte.min.js" asp-append-version="true"></script>


    <!-- Sección para scripts específicos de la vista -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>