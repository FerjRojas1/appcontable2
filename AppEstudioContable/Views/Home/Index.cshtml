@{
    ViewData["Title"] = "Inicio";
}

<!-- Bienvenida -->
<div class="app-card app-mb-4">
    <div class="app-card__body text-center">
        <h5 class="mb-0">
            <i class="fas fa-home me-2"></i>
            <span class="app-text-muted">Bienvenido,</span> @User.Identity?.Name
        </h5>
    </div>
</div>

<!-- Calendario -->
<div class="app-card">
    <div class="app-card__header">
        <h5 class="app-card__title">
            <i class="fas fa-calendar-alt me-2"></i> Agenda
        </h5>
        <button type="button" class="app-btn app-btn--primary app-btn--sm" id="btnNuevoEvento">
            <i class="fas fa-plus"></i> Nuevo evento
        </button>
    </div>
    <div class="app-card__body">
        <div id="calendar"></div>
    </div>
</div>

<!-- ============================================ -->
<!--  MODAL PARA CREAR / EDITAR EVENTO            -->
<!-- ============================================ -->
<div class="modal fade" id="modalEvento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-modal">
            <form id="formEvento">
                <div class="app-modal__header app-modal__header--info">
                    <h5 class="app-modal__title" id="modalEventoTitulo">Nuevo evento</h5>
                </div>

                <div class="app-modal__body">
                    <input type="hidden" id="eventoId" name="Id" />

                    <div class="app-form-group">
                        <label for="eventoTitulo" class="app-form-label">Título</label>
                        <input type="text" class="app-form-control" id="eventoTitulo" name="Titulo" required />
                    </div>

                    <div class="app-form-group">
                        <label for="eventoDescripcion" class="app-form-label">Descripción</label>
                        <textarea class="app-form-control app-form-control--textarea" id="eventoDescripcion" name="Descripcion"></textarea>
                    </div>

                    <div class="app-form-group">
                        <label for="eventoFechaInicio" class="app-form-label">Fecha y hora de inicio</label>
                        <input type="datetime-local" class="app-form-control" id="eventoFechaInicio" name="FechaInicio" required />
                    </div>

                    <div class="app-form-group">
                        <label for="eventoFechaFin" class="app-form-label">Fecha y hora de fin</label>
                        <input type="datetime-local" class="app-form-control" id="eventoFechaFin" name="FechaFin" />
                    </div>

                    <div class="app-form-group">
                        <div class="app-check">
                            <input class="app-check__input" type="checkbox" id="eventoTodoElDia" name="TodoElDia" value="true" />
                            <label class="app-check__label" for="eventoTodoElDia">Todo el día</label>
                        </div>
                    </div>

                    <div class="app-form-group">
                        <label for="eventoColor" class="app-form-label">Color</label>
                        <input type="color" class="app-form-control" id="eventoColor" name="Color" value="#1e40af" />
                    </div>
                </div>

                <div class="app-modal__footer">
                    <button type="button" class="app-btn app-btn--danger app-btn--sm d-none" id="btnEliminarEvento">
                        <i class="fas fa-trash"></i> Eliminar
                    </button>
                    <button type="submit" class="app-btn app-btn--primary">
                        <i class="fas fa-save"></i> Guardar
                    </button>
                    <button type="button" class="app-btn app-btn--outline" data-dismiss="modal">
                        Cancelar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/adminlte/plugins/fullcalendar/main.min.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/adminlte/plugins/moment/moment.min.js" asp-append-version="true"></script>
    <script src="~/adminlte/plugins/fullcalendar/main.min.js" asp-append-version="true"></script>
    <script src="~/adminlte/plugins/fullcalendar-daygrid/main.min.js" asp-append-version="true"></script>
    <script src="~/adminlte/plugins/fullcalendar-timegrid/main.min.js" asp-append-version="true"></script>
    <script src="~/adminlte/plugins/fullcalendar-interaction/main.min.js" asp-append-version="true"></script>
    <script src="~/adminlte/plugins/fullcalendar-bootstrap/main.min.js" asp-append-version="true"></script>
    <script src="~/adminlte/plugins/fullcalendar/locales/es.js" asp-append-version="true"></script>
    <script src="~/js/calendario.js" asp-append-version="true"></script>
}