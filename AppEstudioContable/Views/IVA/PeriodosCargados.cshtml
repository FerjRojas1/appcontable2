@model List<AppEstudioContable.Models.PeriodosModel>

@{
    ViewBag.Title = "Períodos Cargados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
}

<!-- Info del cliente -->
<div class="app-card mb-4">
    <div class="app-card__body text-center">
        <h5 class="mb-0">
            <span class="app-text-muted">Cliente :</span> @ViewBag.RazonSocial
        </h5>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">

                <div class="app-card">
                    <div class="app-card__header">
                        <h5 class="app-card__title">
                            <i class="fas fa-list me-2"></i> Períodos con Comprobantes Cargados
                        </h5>
                    </div>
                    <div class="app-card__body">
                        @if (Model != null && Model.Any())
                        {
                            <div class="table-responsive">
                                <table id="tablaPeriodos" class="app-table app-table--striped">
                                    <thead>
                                        <tr>
                                            <th class="text-center">Período</th>
                                            <th class="text-center">Año</th>
                                            <th class="text-center">Mes</th>
                                            <th class="text-center">Cantidad de Libros</th>
                                            <th class="text-center">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in Model)
                                        {
                                            <tr>
                                                <td class="text-center">
                                                    <strong>@($"{p.Mes:D2}/{p.Ano}")</strong>
                                                </td>
                                                <td class="text-center">@p.Ano</td>
                                                <td class="text-center">@p.Mes</td>
                                             
                                                <td class="text-center">
                                                    @foreach (var libro in p.Libros ?? new List<ServiciosEC.Models.LibroIva>())
                                                    {
                                                        var json = Json.Serialize(libro);
                                                        <button type="button"
                                                                class="app-btn app-btn--info app-btn--sm btn-ver-libro"
                                                                data-toggle="modal"
                                                                data-target="#libroIvaModal"
                                                                data-libro='@Html.Raw(json)'>
                                                            <i class="fas fa-eye me-1"></i> Ver detalle
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="app-empty">
                                <i class="fas fa-inbox"></i>
                                <h4>No hay períodos cargados</h4>
                                <p>Este cliente todavía no tiene comprobantes cargados en el sistema.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Botón Volver -->
                <div class="app-mt-4">
                    <a asp-action="Index"
                       asp-controller="IVA"
                       asp-route-cuit="@ViewBag.Cuit"
                       class="app-btn app-btn--outline">
                        <i class="fas fa-arrow-left me-2"></i> Volver al IVA
                    </a>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- ===================== Modal Libro IVA ===================== -->
<div class="modal fade" id="libroIvaModal" tabindex="-1" role="dialog" aria-labelledby="libroIvaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content app-modal">

            <div class="app-modal__header app-modal__header--info">
                <h5 class="app-modal__title" id="libroIvaModalLabel">
                    <i class="fas fa-book me-2"></i> Resumen del Libro IVA
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="app-modal__body">

                <!-- Débito Fiscal -->
                <div class="app-card app-card--compras mb-4">
                    <div class="app-card__header app-card__header--compras">
                        <h6 class="app-card__title mb-0">Débito Fiscal</h6>
                    </div>
                    <div class="app-card__body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="app-text-muted">Total Débito Fiscal</h6>
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item d-flex justify-content-between">Neto 27%: <span id="campoDebitoNeto27"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto 21%: <span id="campoDebitoNeto21"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto 10.5%: <span id="campoDebitoNeto105"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 27%: <span id="campoDebitoIva27"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 21%: <span id="campoDebitoIva21"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 10.5%: <span id="campoDebitoIva105"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">No Gravado: <span id="campoDebitoNoGravado"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Exento: <span id="campoDebitoExento"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto Otros: <span id="campoDebitoNetoOtros"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA Otros: <span id="campoDebitoIvaOtros"></span></li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="app-text-muted">Total Restitución Débito Fiscal</h6>
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item d-flex justify-content-between">Neto 27%: <span id="campoRestDebitoNeto27"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto 21%: <span id="campoRestDebitoNeto21"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto 10.5%: <span id="campoRestDebitoNeto105"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 27%: <span id="campoRestDebitoIva27"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 21%: <span id="campoRestDebitoIva21"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 10.5%: <span id="campoRestDebitoIva105"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">No Gravado: <span id="campoRestDebitoNoGravado"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Exento: <span id="campoRestDebitoExento"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto Otros: <span id="campoRestDebitoNetoOtros"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA Otros: <span id="campoRestDebitoIvaOtros"></span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Crédito Fiscal -->
                <div class="app-card app-card--ventas mb-4">
                    <div class="app-card__header app-card__header--ventas">
                        <h6 class="app-card__title mb-0">Crédito Fiscal</h6>
                    </div>
                    <div class="app-card__body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="app-text-muted">Total Crédito Fiscal</h6>
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item d-flex justify-content-between">Neto 27%: <span id="campoCreditoNeto27"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto 21%: <span id="campoCreditoNeto21"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto 10.5%: <span id="campoCreditoNeto105"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 27%: <span id="campoCreditoIva27"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 21%: <span id="campoCreditoIva21"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 10.5%: <span id="campoCreditoIva105"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">No Gravado: <span id="campoCreditoNoGravado"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Exento: <span id="campoCreditoExento"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto Otros: <span id="campoCreditoNetoOtros"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA Otros: <span id="campoCreditoIvaOtros"></span></li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="app-text-muted">Total Restitución Crédito Fiscal</h6>
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item d-flex justify-content-between">Neto 27%: <span id="campoRestCreditoNeto27"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto 21%: <span id="campoRestCreditoNeto21"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto 10.5%: <span id="campoRestCreditoNeto105"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 27%: <span id="campoRestCreditoIva27"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 21%: <span id="campoRestCreditoIva21"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA 10.5%: <span id="campoRestCreditoIva105"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">No Gravado: <span id="campoRestCreditoNoGravado"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Exento: <span id="campoRestCreditoExento"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">Neto Otros: <span id="campoRestCreditoNetoOtros"></span></li>
                                    <li class="list-group-item d-flex justify-content-between">IVA Otros: <span id="campoRestCreditoIvaOtros"></span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Resumen Técnico -->
                <div class="app-card app-card--info mb-3">
                    <div class="app-card__header app-card__header--info">
                        <h6 class="app-card__title mb-0">Resumen Técnico</h6>
                    </div>
                    <div class="app-card__body">
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item d-flex justify-content-between">Fecha Declaración: <span id="campoFechaDeclaracion"></span></li>
                            <li class="list-group-item d-flex justify-content-between">Gravado Débito Fiscal: <span id="campoGravadoDebitoFical"></span></li>
                            <li class="list-group-item d-flex justify-content-between">IVA Débito Fiscal: <span id="campoIvaDebitoFiscal"></span></li>
                            <li class="list-group-item d-flex justify-content-between">Gravado Crédito Fiscal: <span id="campoGravadoCreditoFiscal"></span></li>
                            <li class="list-group-item d-flex justify-content-between">IVA Crédito Fiscal: <span id="campoIvaCreditoFiscal"></span></li>
                            <li class="list-group-item d-flex justify-content-between">Saldo Técnico: <span id="campoSaldoTecnico"></span></li>
                            <li class="list-group-item d-flex justify-content-between">Retenciones IVA: <span id="campoRetencionesIVA"></span></li>
                            <li class="list-group-item d-flex justify-content-between">Percepciones IVA: <span id="campoPercepcionesIVA"></span></li>
                            <li class="list-group-item d-flex justify-content-between fw-bold text-primary">Saldo Técnico Neto: <span id="campoSaldoTecnicoNeto"></span></li>
                        </ul>
                    </div>
                </div>

            </div>

            <div class="app-modal__footer">
                <button type="button" class="app-btn app-btn--outline" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="~/js/iva-periodos.js" asp-append-version="true"></script>
}