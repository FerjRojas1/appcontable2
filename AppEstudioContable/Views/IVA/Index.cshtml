@model List<AppEstudioContable.Models.PeriodosModel>


@{
    ViewBag.Title = "IVA";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var graficoIva = ViewBag.GraficoIva as List<AppEstudioContable.Models.DTO.IvaGraficoAnualDto>
                     ?? new List<AppEstudioContable.Models.DTO.IvaGraficoAnualDto>();
}
<div class="card border-0 shadow-sm bg-light mb-4">
    <div class="card-body text-center">
        <h5 class="mb-0 text-dark">
            <span class="text-muted">Cliente : </span> @ViewBag.RazonSocial
        </h5>
    </div>
</div>

<section class="content">
    <div class="container-fluid">       

        <div class="row justify-content-center mt-5">            
            <!-- Card: Ver Período IVA -->
            <div class="col-md-5">
                <div class="card shadow-sm rounded border-0" style="background-color: #f8f9fa;">
                    <div class="card-header bg-white border-bottom-0 text-center">
                        <h5 class="mb-0 text-secondary">Período IVA </h5>                      
                    </div>
                    <div class="card-body">
                        <form asp-action="DetailsPeriodo" method="get">
                            <input type="hidden" name="Cuit" value="@ViewBag.Cuit" />

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="Mes">Mes</label>
                                    <input type="number" class="form-control form-control-sm" id="Mes" name="Mes" min="1" max="12" required placeholder="MM" />
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="Anio">Año</label>
                                    <input type="number" class="form-control form-control-sm" id="Anio" name="año" min="2000" max="2100" required placeholder="AAAA" />
                                </div>
                            </div>

                            <div class="text-center mt-3">
                                <button type="submit" class="btn btn-outline-info px-4 btn-sm">
                                    <i class="fas fa-search me-2"></i> Ver Período
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ===================== Gráfico IVA Anual ===================== -->

@if (graficoIva.Any())
{
    <section class="content">
        <div class="container-fluid">
            <div class="row justify-content-center mt-4">
                <div class="col-12 col-lg-10">
                    <div class="card border-0 shadow-sm rounded" style="background-color: #f8f9fa;">
                        <div class="card-header bg-white border-bottom-0">
                            <div class="d-flex justify-content-between align-items-center flex-wrap">
                                <div>
                                    <h5 class="mb-0 text-secondary">
                                        <i class="fas fa-chart-bar me-2"></i> Totales Netos por Año
                                    </h5>
                                    <small class="text-muted">Crédito Fiscal vs Débito Fiscal</small>
                                </div>
                                <div class="form-inline mt-2 mt-md-0">
                                    <label for="anioGrafico" class="mr-2 mb-0 text-muted small">Año:</label>
                                    <select id="anioGrafico" class="form-control form-control-sm">
                                        @foreach (var d in graficoIva)
                                        {
                                            <option value="@d.Anio">@d.Anio</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <canvas id="graficoIvaAnual" style="max-height: 250px; min-height: 180px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

