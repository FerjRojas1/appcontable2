<div class="mt-4 ms-3">
    <a asp-controller="Cliente"
       asp-action="Details"
       asp-route-id="@ViewBag.id"
       class="btn btn-light border border-secondary text-muted">
        <i class="fas fa-arrow-left me-2"></i> Volver
    </a>
</div>

<!-- Modal IVA -->

<div class="modal fade" id="libroIvaModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Resumen del Libro IVA</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <!-- CARD 1: Débito Fiscal -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h6 class="mb-0 text-dark">Débito Fiscal</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Cuadro 1 -->
                            <div class="col-md-6">
                                <h6 class="text-muted">Total Débito Fiscal</h6>
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item">Neto 27%: <span id="campoDebitoNeto27"></span></li>
                                    <li class="list-group-item">Neto 21%: <span id="campoDebitoNeto21"></span></li>
                                    <li class="list-group-item">Neto 10.5%: <span id="campoDebitoNeto105"></span></li>
                                    <li class="list-group-item">IVA 27%: <span id="campoDebitoIva27"></span></li>
                                    <li class="list-group-item">IVA 21%: <span id="campoDebitoIva21"></span></li>
                                    <li class="list-group-item">IVA 10.5%: <span id="campoDebitoIva105"></span></li>
                                    <li class="list-group-item">No Gravado: <span id="campoDebitoNoGravado"></span></li>
                                    <li class="list-group-item">Exento: <span id="campoDebitoExento"></span></li>
                                    <li class="list-group-item">Neto Otros: <span id="campoDebitoNetoOtros"></span></li>
                                    <li class="list-group-item">IVA Otros: <span id="campoDebitoIvaOtros"></span></li>
                                </ul>
                            </div>

                            <!-- Cuadro 2 -->
                            <div class="col-md-6">
                                <h6 class="text-muted">Total Restitución Débito Fiscal</h6>
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item">Neto 27%: <span id="campoRestDebitoNeto27"></span></li>
                                    <li class="list-group-item">Neto 21%: <span id="campoRestDebitoNeto21"></span></li>
                                    <li class="list-group-item">Neto 10.5%: <span id="campoRestDebitoNeto105"></span></li>
                                    <li class="list-group-item">IVA 27%: <span id="campoRestDebitoIva27"></span></li>
                                    <li class="list-group-item">IVA 21%: <span id="campoRestDebitoIva21"></span></li>
                                    <li class="list-group-item">IVA 10.5%: <span id="campoRestDebitoIva105"></span></li>
                                    <li class="list-group-item">No Gravado: <span id="campoRestDebitoNoGravado"></span></li>
                                    <li class="list-group-item">Exento: <span id="campoRestDebitoExento"></span></li>
                                    <li class="list-group-item">Neto Otros: <span id="campoRestDebitoNetoOtros"></span></li>
                                    <li class="list-group-item">IVA Otros: <span id="campoRestDebitoIvaOtros"></span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CARD 2: Crédito Fiscal -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h6 class="mb-0 text-dark">Crédito Fiscal</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Cuadro 1 -->
                            <div class="col-md-6">
                                <h6 class="text-muted">Total Crédito Fiscal</h6>
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item">Neto 27%: <span id="campoCreditoNeto27"></span></li>
                                    <li class="list-group-item">Neto 21%: <span id="campoCreditoNeto21"></span></li>
                                    <li class="list-group-item">Neto 10.5%: <span id="campoCreditoNeto105"></span></li>
                                    <li class="list-group-item">IVA 27%: <span id="campoCreditoIva27"></span></li>
                                    <li class="list-group-item">IVA 21%: <span id="campoCreditoIva21"></span></li>
                                    <li class="list-group-item">IVA 10.5%: <span id="campoCreditoIva105"></span></li>
                                    <li class="list-group-item">No Gravado: <span id="campoCreditoNoGravado"></span></li>
                                    <li class="list-group-item">Exento: <span id="campoCreditoExento"></span></li>
                                    <li class="list-group-item">Neto Otros: <span id="campoCreditoNetoOtros"></span></li>
                                    <li class="list-group-item">IVA Otros: <span id="campoCreditoIvaOtros"></span></li>
                                </ul>
                            </div>

                            <!-- Cuadro 2 -->
                            <div class="col-md-6">
                                <h6 class="text-muted">Total Restitución Crédito Fiscal</h6>
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item">Neto 27%: <span id="campoRestCreditoNeto27"></span></li>
                                    <li class="list-group-item">Neto 21%: <span id="campoRestCreditoNeto21"></span></li>
                                    <li class="list-group-item">Neto 10.5%: <span id="campoRestCreditoNeto105"></span></li>
                                    <li class="list-group-item">IVA 27%: <span id="campoRestCreditoIva27"></span></li>
                                    <li class="list-group-item">IVA 21%: <span id="campoRestCreditoIva21"></span></li>
                                    <li class="list-group-item">IVA 10.5%: <span id="campoRestCreditoIva105"></span></li>
                                    <li class="list-group-item">No Gravado: <span id="campoRestCreditoNoGravado"></span></li>
                                    <li class="list-group-item">Exento: <span id="campoRestCreditoExento"></span></li>
                                    <li class="list-group-item">Neto Otros: <span id="campoRestCreditoNetoOtros"></span></li>
                                    <li class="list-group-item">IVA Otros: <span id="campoRestCreditoIvaOtros"></span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CARD 3: Totales -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0 text-dark">Resumen Técnico</h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item">Fecha Declaración: <span id="campoFechaDeclaracion"></span></li>
                            <li class="list-group-item">Gravado Débito Fiscal: <span id="campoGravadoDebitoFical"></span></li>
                            <li class="list-group-item">IVA Débito Fiscal: <span id="campoIvaDebitoFiscal"></span></li>
                            <li class="list-group-item">Gravado Crédito Fiscal: <span id="campoGravadoCreditoFiscal"></span></li>
                            <li class="list-group-item">IVA Crédito Fiscal: <span id="campoIvaCreditoFiscal"></span></li>
                            <li class="list-group-item">Saldo Técnico: <span id="campoSaldoTecnico"></span></li>
                            <li class="list-group-item">Retenciones IVA: <span id="campoRetencionesIVA"></span></li>
                            <li class="list-group-item">Percepciones IVA: <span id="campoPercepcionesIVA"></span></li>
                            <li class="list-group-item font-weight-bold text-primary">Saldo Técnico Neto: <span id="campoSaldoTecnicoNeto"></span></li>
                        </ul>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>
        // Pasamos los datos del gráfico como variable global
        window.datosGraficoIva = @Html.Raw(Json.Serialize(ViewBag.GraficoIva ?? new List<object>()));
    </script>

    <script src="~/js/iva-index.js" asp-append-version="true"></script>
}

